            ["SOGAMOSO", "SANTANDER", "SAN VICENTE DE CHUCURÍ", "12-02-0046-V", "0", "LIBERADO", 3],
            ["SOGAMOSO", "SANTANDER", "SUCRE", "12-10-0468", "VANO", "LIBERADO", 3],
            ["SOGAMOSO", "SANTANDER", "VELEZ", "12-06-0211", "189", "LIBERADO", 3]
        ];

        /* ================================================================
           2. PROCESAR DATOS
        ================================================================ */
        function determinarSemaforo(control, estadoConcreto) {
            const e = (estadoConcreto || '').toUpperCase().trim();
            if (e.includes('AMPARO') || e.includes('DEMANDA RETIRADA') || e.includes('NO LIBERADO')) {
                return 'rojo';
            }
            if (control === 1) return 'rojo';
            if (control === 2) return 'amarillo';
            if (control === 3) return 'verde';
            if (e === 'LIBERADO') return 'verde';
            if (e === 'EN TRÁMITE') return 'amarillo';
            return 'rojo';
        }

        function limpiarEstado(estado) {
            if (!estado) return '';
            const e = estado.trim();
            if (e.toUpperCase() === 'DEMANDA RETIRADA') return 'Retirada';
            if (e.toLowerCase() === 'amparo en trámite') return 'Amparo';
            return e;
        }

        const proyectos = datosRaw.map(row => {
            const estadoOriginal = row[5] || '';
            const estadoLimpio = limpiarEstado(estadoOriginal);
            return {
                proyecto: row[0],
                departamento: row[1],
                municipio: row[2],
                idPredio: row[3],
                torres: row[4] || '',
                estadoConcreto: estadoLimpio,
                estadoOriginal: estadoOriginal,
                control: parseInt(row[6]) || 0,
                semaforo: determinarSemaforo(parseInt(row[6]) || 0, estadoOriginal)
            };
        });

        /* ================================================================
           3. UTILIDADES VISUALES
        ================================================================ */
        function esc(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '<').replace(/>/g, '>')
                .replace(/"/g, '"').replace(/'/g, '&#39;');
        }

        function animateCounter(element, target, duration = 900) {
            const startTime = performance.now();
            const from = 0;
            function update(now) {
                const p = Math.min((now - startTime) / duration, 1);
                const eased = 1 - Math.pow(1 - p, 3);
                element.textContent = Math.floor(eased * (target - from) + from);
                if (p < 1) requestAnimationFrame(update);
                else element.textContent = target;
            }
            requestAnimationFrame(update);
        }

        function semaforoLabel(s) {
            return s.charAt(0).toUpperCase() + s.slice(1);
        }

        function semaforoIcon(s) {
            if (s === 'rojo') return '🔴';
            if (s === 'amarillo') return '🟡';
            return '🟢';
        }

        /* ================================================================
           4. TARJETAS KPI + ANILLO + COMPARATIVA
        ================================================================ */
        function renderKpis() {
            const total = proyectos.length;
            const rojos = proyectos.filter(p => p.semaforo === 'rojo').length;
            const amarillos = proyectos.filter(p => p.semaforo === 'amarillo').length;
            const verdes = proyectos.filter(p => p.semaforo === 'verde').length;
            animateCounter(document.getElementById('totalCard'), total);
            animateCounter(document.getElementById('rojoCard'), rojos);
            animateCounter(document.getElementById('amarilloCard'), amarillos);
            animateCounter(document.getElementById('verdeCard'), verdes);

            // Anillo de liberación
            const pct = total ? Math.round((verdes / total) * 100) : 0;
            const ring = document.getElementById('ringLiberacion');
            const r = 36;
            const circ = 2 * Math.PI * r;
            const color = pct >= 60 ? '#22c55e' : pct >= 30 ? '#f1c40f' : '#ef4444';
            ring.innerHTML = `
                <svg viewBox="0 0 80 80">
                    <circle class="ring-bg" cx="40" cy="40" r="${r}"></circle>
                    <circle class="ring-fg" cx="40" cy="40" r="${r}" stroke="${color}"
                        stroke-dasharray="${circ}" stroke-dashoffset="${circ}" id="ringFg"></circle>
                </svg>
                <div class="ring-lbl"><b id="ringPct">0%</b><small>liberado</small></div>`;
            requestAnimationFrame(() => {
                setTimeout(() => {
                    document.getElementById('ringFg').style.strokeDashoffset = circ - (circ * pct) / 100;
                    animateCounter(document.getElementById('ringPct'), pct, 1200);
                }, 150);
            });

            // Comparativa NORTE vs SOGAMOSO
            const norte = proyectos.filter(p => p.proyecto === 'NORTE');
            const soga = proyectos.filter(p => p.proyecto === 'SOGAMOSO');
            const pctNorte = norte.length ? Math.round((norte.filter(p => p.semaforo === 'verde').length / norte.length) * 100) : 0;
            const pctSoga = soga.length ? Math.round((soga.filter(p => p.semaforo === 'verde').length / soga.length) * 100) : 0;
            setTimeout(() => {
                document.getElementById('barNorte').style.width = pctNorte + '%';
                document.getElementById('barSoga').style.width = pctSoga + '%';
            }, 200);
            document.getElementById('valNorte').textContent = pctNorte + '%';
            document.getElementById('valSoga').textContent = pctSoga + '%';
            const stats = (arr, nombre) => {
                const r = arr.filter(p => p.semaforo === 'rojo').length;
                const a = arr.filter(p => p.semaforo === 'amarillo').length;
                const v = arr.filter(p => p.semaforo === 'verde').length;
                return `<span><b>${nombre}</b></span><span>🔴 ${r}</span><span>🟡 ${a}</span><span>🟢 ${v}</span>`;
            };
            document.getElementById('compStats').innerHTML = stats(norte, 'NORTE') + stats(soga, 'SOGAMOSO');
        }

        /* ================================================================
           5. FILTRO ESTADO + RENDER TABLA CON SORT/PAGINACIÓN/RESALTADO
        ================================================================ */
        function populateEstadoFilter() {
            const estados = [...new Set(proyectos.map(p => p.estadoConcreto).filter(e => e !== ''))].sort();
            const select = document.getElementById('filtroEstado');
            while (select.options.length > 1) select.remove(1);
            estados.forEach(e => {
                const opt = document.createElement('option');
                opt.value = e;
                opt.textContent = e;
                select.appendChild(opt);
            });
        }

        const estadoFiltros = {
            proyecto: 'todos',
            semaforo: 'todos',
            estado: 'todos',
            busqueda: ''
        };
        let sortKey = 'semaforo';
        let sortOrder = 'asc';
        let paginaActual = 1;
        const porPagina = 8;

        function aplicarFiltros() {
            estadoFiltros.proyecto = document.getElementById('filtroProyecto').value;
            estadoFiltros.semaforo = document.getElementById('filtroSemaforo').value;
            estadoFiltros.estado = document.getElementById('filtroEstado').value;
            estadoFiltros.busqueda = document.getElementById('filtroBusqueda').value.trim();
            paginaActual = 1;
            renderTabla();
            renderChips();
        }

        function filtrarProyectos() {
            const q = estadoFiltros.busqueda.toLowerCase();
            return proyectos.filter(p => {
                if (estadoFiltros.proyecto !== 'todos' && p.proyecto !== estadoFiltros.proyecto) return false;
                if (estadoFiltros.semaforo !== 'todos' && p.semaforo !== estadoFiltros.semaforo) return false;
                if (estadoFiltros.estado !== 'todos' && p.estadoConcreto !== estadoFiltros.estado) return false;
                if (q) {
                    return (p.municipio + ' ' + p.idPredio + ' ' + p.torres + ' ' + p.departamento + ' ' +
                            p.proyecto + ' ' + p.estadoConcreto).toLowerCase().includes(q);
                }
                return true;
            });
        }

        function resaltar(texto, q) {
            if (!q) return esc(texto);
            const idx = texto.toLowerCase().indexOf(q.toLowerCase());
            if (idx === -1) return esc(texto);
            return esc(texto.slice(0, idx)) + '<mark>' + esc(texto.slice(idx, idx + q.length)) + '</mark>' + esc(texto.slice(idx + q.length));
        }

        function renderTabla() {
            let filtrados = filtrarProyectos();

            // Ordenar
            const orderMul = sortOrder === 'asc' ? 1 : -1;
            filtrados.sort((a, b) => {
                let va = a[sortKey], vb = b[sortKey];
                if (typeof va === 'string') va = va.toLowerCase();
                if (typeof vb === 'string') vb = vb.toLowerCase();
                if (va < vb) return -1 * orderMul;
                if (va > vb) return 1 * orderMul;
                return 0;
            });

            const totalPaginas = Math.max(1, Math.ceil(filtrados.length / porPagina));
            if (paginaActual > totalPaginas) paginaActual = totalPaginas;
            const inicio = (paginaActual - 1) * porPagina;
            const pagina = filtrados.slice(inicio, inicio + porPagina);
            const q = estadoFiltros.busqueda;

            document.getElementById('filaMostradas').textContent = filtrados.length;
            document.getElementById('filaInfo').textContent = filtrados.length + ' registros';
            document.getElementById('pageInfo').textContent = paginaActual + ' / ' + totalPaginas;
            document.getElementById('pagePrev').disabled = paginaActual <= 1;
            document.getElementById('pageNext').disabled = paginaActual >= totalPaginas;

            const tbody = document.getElementById('tablaBody');
            if (pagina.length === 0) {
                tbody.innerHTML = `<tr class="empty-row"><td colspan="7"><i class="fas fa-search"></i>No se encontraron registros</td></tr>`;
                return;
            }

            let html = '';
            pagina.forEach(p => {
                const tooltip = 'ID: ' + p.idPredio + ' | Torre: ' + (p.torres || 'N/A');
                html += `<tr data-tooltip="${esc(tooltip)}">
                    <td><span class="proye-tag ${p.proyecto === 'NORTE' ? 'norte' : 'soga'}">${resaltar(p.proyecto, q)}</span></td>
                    <td>${resaltar(p.departamento, q)}</td>
                    <td>${resaltar(p.municipio, q)}</td>
                    <td>${resaltar(p.idPredio, q)}</td>
                    <td>${p.torres ? resaltar(p.torres, q) : '-'}</td>
                    <td>${p.estadoConcreto ? resaltar(p.estadoConcreto, q) : '-'}</td>
                    <td>
                        <span class="semafo ${p.semaforo}"></span>
                        <span class="estado-badge ${p.semaforo}">${semaforoLabel(p.semaforo)}</span>
                    </td>
                </tr>`;
            });
            tbody.innerHTML = html;
        }

        function renderChips() {
            const cont = document.getElementById('chipsActivos');
            cont.innerHTML = '';
            const chips = [];
            if (estadoFiltros.proyecto !== 'todos') chips.push(['proyecto', estadoFiltros.proyecto, 'Proyecto: ' + estadoFiltros.proyecto]);
            if (estadoFiltros.semaforo !== 'todos') chips.push(['semaforo', estadoFiltros.semaforo, 'Semáforo: ' + semaforoIcon(estadoFiltros.semaforo) + ' ' + semaforoLabel(estadoFiltros.semaforo)]);
            if (estadoFiltros.estado !== 'todos') chips.push(['estado', estadoFiltros.estado, 'Estado: ' + estadoFiltros.estado]);
            if (estadoFiltros.busqueda) chips.push(['busqueda', estadoFiltros.busqueda, 'Buscar: "' + estadoFiltros.busqueda + '"']);
            chips.forEach(c => {
                const el = document.createElement('span');
                el.className = 'chip';
                el.innerHTML = c[2] + `<button title="Quitar filtro" data-chip="${c[0]}"><i class="fas fa-times"></i></button>`;
                cont.appendChild(el);
            });
            cont.querySelectorAll('button').forEach(b => {
                b.addEventListener('click', () => {
                    const key = b.dataset.chip;
                    if (key === 'proyecto') document.getElementById('filtroProyecto').value = 'todos';
                    if (key === 'semaforo') document.getElementById('filtroSemaforo').value = 'todos';
                    if (key === 'estado') document.getElementById('filtroEstado').value = 'todos';
                    if (key === 'busqueda') document.getElementById('filtroBusqueda').value = '';
                    aplicarFiltros();
                });
            });
        }

        function limpiarFiltros() {
            document.getElementById('filtroProyecto').value = 'todos';
            document.getElementById('filtroSemaforo').value = 'todos';
            document.getElementById('filtroEstado').value = 'todos';
            document.getElementById('filtroBusqueda').value = '';
            aplicarFiltros();
            mostrarToast('Filtros limpiados', 'success');
        }

        document.getElementById('btnLimpiar').addEventListener('click', limpiarFiltros);
        document.getElementById('filtroProyecto').addEventListener('change', aplicarFiltros);
        document.getElementById('filtroSemaforo').addEventListener('change', aplicarFiltros);
        document.getElementById('filtroEstado').addEventListener('change', aplicarFiltros);
        document.getElementById('filtroBusqueda').addEventListener('input', aplicarFiltros);
        document.getElementById('pagePrev').addEventListener('click', () => { if (paginaActual > 1) { paginaActual--; renderTabla(); } });
        document.getElementById('pageNext').addEventListener('click', () => { const total = Math.ceil(filtrarProyectos().length / porPagina); if (paginaActual < total) { paginaActual++; renderTabla(); } });

        // Ordenamiento por columna
        document.querySelectorAll('#tablaHead th').forEach(th => {
            th.addEventListener('click', () => {
                const key = th.dataset.sort;
                if (sortKey === key) {
                    sortOrder = sortOrder === 'asc' ? 'desc' : 'asc';
                } else {
                    sortKey = key;
                    sortOrder = 'asc';
                }
                document.querySelectorAll('#tablaHead th').forEach(t => t.classList.remove('active'));
                th.classList.add('active');
                th.querySelector('.sort-icon').className = 'sort-icon fas fa-sort-' + (sortOrder === 'asc' ? 'up' : 'down');
                renderTabla();
            });
        });

        // Click en fila => modal
        document.getElementById('tablaBody').addEventListener('click', e => {
            const tr = e.target.closest('tr');
            if (!tr || tr.classList.contains('empty-row')) return;
            const id = tr.children[3].textContent.trim().replace('<mark>', '').replace('</mark>', '');
            const fila = proyectos.find(p => p.idPredio === id || p.idPredio.includes(id));
            if (fila) abrirModal(fila);
        });

        /* ================================================================
           6. GRÁFICAS CHART.JS
        ================================================================ */
        function textColor() { return getComputedStyle(document.documentElement).getPropertyValue('--chart-text').trim() || '#64748b'; }
        function gridColor() { return getComputedStyle(document.documentElement).getPropertyValue('--chart-grid').trim() || 'rgba(0,0,0,0.06)'; }
        function baseFont() { return { family: 'Inter, sans-serif', size: 11 }; }

        const customLabelsPlugin = {
            id: 'customLabels',
            afterDraw(chart) {
                const ctx = chart.ctx;
                chart.data.datasets.forEach((ds, i) => {
                    const meta = chart.getDatasetMeta(i);
                    meta.data.forEach((bar, idx) => {
                        const v = ds.data[idx];
                        if (v === 0 || v == null) return;
                        ctx.save();
                        ctx.fillStyle = textColor();
                        ctx.font = 'bold 12px Inter';
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'bottom';
                        ctx.fillText(v, bar.x, bar.y - 3);
                        ctx.restore();
                    });
                });
            }
        };

        let chartSemaforo, chartEstado, chartComparativa, chartMunicipios, chartTorres, chartGauge, chartTendencia, chartDeptos;

        function initCharts() {
            const rojos = proyectos.filter(p => p.semaforo === 'rojo').length;
            const amarillos = proyectos.filter(p => p.semaforo === 'amarillo').length;
            const verdes = proyectos.filter(p => p.semaforo === 'verde').length;
            const total = proyectos.length;

            /* ---- 6.1 Semáforo (donut con total al centro) ---- */
            const elSemaforo = document.getElementById('chartSemaforo');
            const ctxSemaforo = elSemaforo.getContext('2d');
            chartSemaforo = new Chart(ctxSemaforo, {
                type: 'doughnut',
                data: {
                    labels: ['🔴 Rojo', '🟡 Amarillo', '🟢 Verde'],
                    datasets: [{
                        data: [rojos, amarillos, verdes],
                        backgroundColor: ['#ef4444', '#f1c40f', '#22c55e'],
                        borderWidth: 3,
                        borderColor: getComputedStyle(document.body).getPropertyValue('--card').trim() || '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '62%',
                    plugins: {
                        legend: { position: 'bottom', labels: { color: textColor(), font: baseFont(), boxWidth: 12 } },
                        tooltip: { callbacks: { label: c => ` ${c.label}: ${c.parsed} predios` } }
                    },
                    onClick: (e, els) => {
                        if (els.length) {
                            const labels = ['rojo', 'amarillo', 'verde'];
                            document.getElementById('filtroSemaforo').value = labels[els[0].index];
                            aplicarFiltros();
                        }
                    }
                },
                plugins: [{
                    id: 'centerText',
                    afterDraw(chart) {
                        const { ctx } = chart;
                        const x = chart.chartArea.left + (chart.chartArea.right - chart.chartArea.left) / 2;
                        const y = chart.chartArea.top + (chart.chartArea.bottom - chart.chartArea.top) / 2;
                        ctx.save();
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'middle';
                        ctx.fillStyle = textColor();
                        ctx.font = '800 26px Outfit';
                        ctx.fillText(total, x, y - 9);
                        ctx.font = '600 10px Inter';
                        ctx.fillText('TOTAL', x, y + 11);
                        ctx.restore();
                    }
                }]
            });

            /* ---- 6.2 Estado Concreto (barras) ---- */
            const ctxEstado = document.getElementById('chartEstado').getContext('2d');
            const estados = {};
            proyectos.forEach(p => { if (p.estadoConcreto) estados[p.estadoConcreto] = (estados[p.estadoConcreto] || 0) + 1; });
            const sortedEstados = Object.entries(estados).sort((a, b) => b[1] - a[1]);
            const labelsEstados = sortedEstados.map(e => e[0]);
            const dataEstados = sortedEstados.map(e => e[1]);
            const coloresEstados = ['#22c55e', '#f1c40f', '#ef4444', '#38bdf8', '#a78bfa', '#2dd4bf', '#fb923c'];
            chartEstado = new Chart(ctxEstado, {
                type: 'bar',
                data: {
                    labels: labelsEstados,
                    datasets: [{
                        label: 'Cantidad',
                        data: dataEstados,
                        backgroundColor: coloresEstados.slice(0, labelsEstados.length),
                        borderRadius: 8,
                        borderSkipped: false,
                        barPercentage: 0.65
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: c => ` ${c.parsed.y} predios` } }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { color: gridColor() }, ticks: { stepSize: 1, color: textColor(), font: baseFont() } },
                        x: { grid: { display: false }, ticks: { color: textColor(), font: { size: 10, family: 'Inter' }, maxRotation: 45, minRotation: 0 } }
                    },
                    onClick: (e, els) => {
                        if (els.length) {
                            const estado = labelsEstados[els[0].index];
                            const sel = document.getElementById('filtroEstado');
                            const exists = Array.from(sel.options).some(o => o.value === estado);
                            if (exists) sel.value = estado;
                            else document.getElementById('filtroBusqueda').value = estado;
                            aplicarFiltros();
                        }
                    }
                },
                plugins: [customLabelsPlugin]
            });

            /* ---- 6.3 Comparativa NORTE vs SOGAMOSO (apilada) ---- */
            const ctxComp = document.getElementById('chartComparativa').getContext('2d');
            const build = proy => [proy.filter(p => p.semaforo === 'rojo').length, proy.filter(p => p.semaforo === 'amarillo').length, proy.filter(p => p.semaforo === 'verde').length];
            const norteArr = build(proyectos.filter(p => p.proyecto === 'NORTE'));
            const sogaArr = build(proyectos.filter(p => p.proyecto === 'SOGAMOSO'));
            chartComparativa = new Chart(ctxComp, {
                type: 'bar',
                data: {
                    labels: ['NORTE', 'SOGAMOSO'],
                    datasets: [
                        { label: '🔴 Crítico', data: [norteArr[0], sogaArr[0]], backgroundColor: '#ef4444' },
                        { label: '🟡 Alerta', data: [norteArr[1], sogaArr[1]], backgroundColor: '#f1c40f' },
                        { label: '🟢 Liberado', data: [norteArr[2], sogaArr[2]], backgroundColor: '#22c55e' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { color: textColor(), font: baseFont(), boxWidth: 12 } },
                        tooltip: { callbacks: { label: c => ` ${c.dataset.label}: ${c.parsed.y}` } }
                    },
                    scales: {
                        x: { stacked: true, grid: { display: false }, ticks: { color: textColor(), font: baseFont() } },
                        y: { stacked: true, beginAtZero: true, grid: { color: gridColor() }, ticks: { stepSize: 1, color: textColor(), font: baseFont() } }
                    }
                }
            });

            /* ---- 6.4 Top 8 municipios ---- */
            const ctxMun = document.getElementById('chartMunicipios').getContext('2d');
            const muns = {};
            proyectos.forEach(p => { const m = p.municipio || 'Sin municipio'; muns[m] = (muns[m] || 0) + 1; });
            const topMuns = Object.entries(muns).sort((a, b) => b[1] - a[1]).slice(0, 8);
            chartMunicipios = new Chart(ctxMun, {
                type: 'bar',
                data: {
                    labels: topMuns.map(m => m[0]),
                    datasets: [{
                        label: 'Predios',
                        data: topMuns.map(m => m[1]),
                        backgroundColor: ['#0072bc', '#00a651', '#f1c40f', '#ef4444', '#8b5cf6', '#06b6d4', '#f97316', '#64748b'],
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: c => ` ${c.parsed.x} predios` } }
                    },
                    scales: {
                        x: { beginAtZero: true, grid: { color: gridColor() }, ticks: { stepSize: 1, color: textColor(), font: baseFont() } },
                        y: { grid: { display: false }, ticks: { color: textColor(), font: { size: 10, family: 'Inter' } } }
                    },
                    onClick: (e, els) => {
                        if (els.length) {
                            document.getElementById('filtroBusqueda').value = topMuns[els[0].index][0];
                            aplicarFiltros();
                        }
                    }
                },
                plugins: [customLabelsPlugin]
            });

            /* ---- 6.5 Torres por tipo ---- */
            const ctxTorres = document.getElementById('chartTorres').getContext('2d');
            let vano = 0, numeros = 0, otros = 0;
            proyectos.forEach(p => {
                const t = (p.torres || '').trim().toUpperCase();
                if (!t || t === 'VANO') vano++;
                else if (/[0-9]/.test(t)) numeros++;
                else otros++;
            });
            chartTorres = new Chart(ctxTorres, {
                type: 'doughnut',
                data: {
                    labels: ['VANO', 'Con números', 'Otros'],
                    datasets: [{
                        data: [vano, numeros, otros],
                        backgroundColor: ['#94a3b8', '#38bdf8', '#fb923c'],
                        borderWidth: 3,
                        borderColor: getComputedStyle(document.body).getPropertyValue('--card').trim() || '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '60%',
                    plugins: {
                        legend: { position: 'bottom', labels: { color: textColor(), font: baseFont(), boxWidth: 12 } },
                        tooltip: { callbacks: { label: c => ` ${c.label}: ${c.parsed} predios` } }
                    }
                }
            });

            /* ---- 6.6 Gauge de liberación ---- */
            const ctxGauge = document.getElementById('chartGauge').getContext('2d');
            const pctLiberado = total ? Math.round((verdes / total) * 100) : 0;
            const gaugeColor = pctLiberado >= 60 ? '#22c55e' : pctLiberado >= 30 ? '#f1c40f' : '#ef4444';
            chartGauge = new Chart(ctxGauge, {
                type: 'doughnut',
                data: {
                    labels: ['Liberado', 'Pendiente'],
                    datasets: [{
                        data: [pctLiberado, 100 - pctLiberado],
                        backgroundColor: [gaugeColor, 'rgba(148,163,184,0.25)'],
                        borderWidth: 0,
                        circumference: 270,
                        rotation: 225
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: { display: false },
                        tooltip: { enabled: false }
                    }
                },
                plugins: [{
                    id: 'gaugeText',
                    afterDraw(chart) {
                        const { ctx } = chart;
                        const x = chart.chartArea.left + (chart.chartArea.right - chart.chartArea.left) / 2;
                        const y = chart.chartArea.top + (chart.chartArea.bottom - chart.chartArea.top) / 2 + 6;
                        ctx.save();
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'middle';
                        ctx.fillStyle = textColor();
                        ctx.font = '800 28px Outfit';
                        ctx.fillText(pctLiberado + '%', x, y - 6);
                        ctx.font = '600 10px Inter';
                        ctx.fillStyle = gaugeColor;
                        ctx.fillText('LIBERADO', x, y + 16);
                        ctx.restore();
                    }
                }]
            });

            /* ---- 6.7 Tendencia últimos 7 días (simulada) ---- */
            const ctxTend = document.getElementById('chartTendencia').getContext('2d');
            const dias = [];
            const fec = new Date();
            fec.setDate(fec.getDate() - 6);
            for (let i = 0; i < 7; i++) {
                const d = new Date(fec);
                dias.push(d.toLocaleDateString('es-CO', { weekday: 'short' }));
                fec.setDate(fec.getDate() + 1);
            }
            const base = Math.round(verdes / 7);
            const vals = dias.map((_, i) => Math.max(1, Math.round(base * (0.7 + i * 0.08)) + (i % 3)));
            chartTendencia = new Chart(ctxTend, {
                type: 'line',
                data: {
                    labels: dias,
                    datasets: [{
                        label: 'Liberaciones acumuladas',
                        data: vals,
                        borderColor: '#00a651',
                        backgroundColor: 'rgba(0,166,81,0.12)',
                        fill: true,
                        tension: 0.4,
                        pointRadius: 4,
                        pointBackgroundColor: '#00a651'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: c => ` ${c.parsed.y} liberaciones` } }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { color: gridColor() }, ticks: { stepSize: 1, color: textColor(), font: baseFont() } },
                        x: { grid: { display: false }, ticks: { color: textColor(), font: baseFont() } }
                    }
                }
            });

            /* ---- 6.8 Predios por departamento ---- */
            const ctxDeptos = document.getElementById('chartDeptos').getContext('2d');
            const deptos = {};
            proyectos.forEach(p => { const d = p.departamento || 'Sin departamento'; deptos[d] = (deptos[d] || 0) + 1; });
            const sortedDeptos = Object.entries(deptos).sort((a, b) => b[1] - a[1]);
            chartDeptos = new Chart(ctxDeptos, {
                type: 'bar',
                data: {
                    labels: sortedDeptos.map(d => d[0]),
                    datasets: [{
                        label: 'Predios',
                        data: sortedDeptos.map(d => d[1]),
                        backgroundColor: ['#2c3e50', '#e74c3c', '#f39c12'],
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: c => ` ${c.parsed.y} predios` } }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { color: gridColor() }, ticks: { stepSize: 1, color: textColor(), font: baseFont() } },
                        x: { grid: { display: false }, ticks: { color: textColor(), font: { size: 11, family: 'Inter', weight: 'bold' } } }
                    }
                },
                plugins: [customLabelsPlugin]
            });
        }

        /* ================================================================
           7. MODAL DE DETALLE
        ================================================================ */
        function abrirModal(p) {
            const body = document.getElementById('modalBody');
            const porc = p.estadoConcreto ? '—' : '—';
            body.innerHTML = `
                <div class="detail-item"><div class="d-label">Proyecto</div><div class="d-value">${esc(p.proyecto)}</div></div>
                <div class="detail-item"><div class="d-label">Departamento</div><div class="d-value">${esc(p.departamento)}</div></div>
                <div class="detail-item"><div class="d-label">Municipio</div><div class="d-value">${esc(p.municipio)}</div></div>
                <div class="detail-item"><div class="d-label">ID Predio</div><div class="d-value">${esc(p.idPredio)}</div></div>
                <div class="detail-item"><div class="d-label">Torres</div><div class="d-value">${esc(p.torres || '-')}</div></div>
                <div class="detail-item"><div class="d-label">Estado Concreto</div><div class="d-value">${esc(p.estadoConcreto || '-')}</div></div>
                <div class="detail-item"><div class="d-label">Semáforo</div><div class="d-value"><span class="semafo ${p.semaforo}"></span> ${semaforoLabel(p.semaforo)}</div></div>
                <div class="detail-item"><div class="d-label">Estado original</div><div class="d-value">${esc(p.estadoOriginal || '-')}</div></div>
            `;
            document.getElementById('modalSub').textContent = 'ID ' + p.idPredio;
            document.getElementById('modalDetalle').classList.add('open');
        }
        document.getElementById('modalClose').addEventListener('click', () => document.getElementById('modalDetalle').classList.remove('open'));
        document.getElementById('modalDetalle').addEventListener('click', e => {
            if (e.target === e.currentTarget) document.getElementById('modalDetalle').classList.remove('open');
        });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') document.getElementById('modalDetalle').classList.remove('open');
        });

        /* ================================================================
           8. ALERTAS
        ================================================================ */
        function renderAlertas() {
            const criticos = proyectos.filter(p => p.semaforo === 'rojo');
            document.getElementById('alertCount').textContent = criticos.length;
            document.getElementById('alertsBadge').textContent = criticos.length;
            const list = document.getElementById('alertsList');
            if (criticos.length === 0) {
                list.innerHTML = `<div class="alert-item" style="justify-content:center;"><span>🎉 No hay alertas críticas</span></div>`;
                return;
            }
            list.innerHTML = criticos.slice(0, 8).map(p => `
                <div class="alert-item rojo">
                    <div class="a-ico"><i class="fas fa-exclamation-triangle"></i></div>
                    <div class="a-text">
                        <b>${esc(p.municipio)} · ${esc(p.proyecto)}</b>
                        <span>${esc(p.idPredio)} · ${esc(p.estadoConcreto || 'Sin estado')}</span>
                    </div>
                </div>`).join('');
        }
        function toggleAlertas() {
            document.getElementById('alertsPanel').classList.toggle('open');
        }
        document.getElementById('alertsToggle').addEventListener('click', toggleAlertas);
        document.getElementById('btnAlerts').addEventListener('click', toggleAlertas);
        document.addEventListener('click', e => {
            const panel = document.getElementById('alertsPanel');
            if (panel.classList.contains('open') && !panel.contains(e.target) && e.target.id !== 'alertsToggle' && e.target.id !== 'btnAlerts') {
                panel.classList.remove('open');
            }
        });

        /* ================================================================
           9. TOAST
        ================================================================ */
        let toastTimer;
        function mostrarToast(msg, tipo = 'info') {
            const toast = document.getElementById('toast');
            toast.className = 'toast ' + tipo + ' show';
            document.getElementById('toastMsg').textContent = msg;
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.remove('show'), 2600);
        }

        /* ================================================================
           10. TEMA CLARO / OSCURO
        ================================================================ */
        function aplicarTema(tema) {
            document.documentElement.setAttribute('data-theme', tema);
            const icon = document.getElementById('temaIcon');
            if (tema === 'dark') {
                icon.className = 'fas fa-sun';
                mostrarToast('Modo oscuro activado', 'info');
            } else {
                icon.className = 'fas fa-moon';
                mostrarToast('Modo claro activado', 'info');
            }
            localStorage.setItem('geb-theme', tema);
            // Re-render de gráficas con nuevos colores
            try {
                chartSemaforo && chartSemaforo.update();
                chartEstado && chartEstado.update();
                chartComparativa && chartComparativa.update();
                chartMunicipios && chartMunicipios.update();
                chartTorres && chartTorres.update();
                chartGauge && chartGauge.update();
                chartTendencia && chartTendencia.update();
                chartDeptos && chartDeptos.update();
            } catch (err) { console.warn(err); }
        }
        document.getElementById('btnTema').addEventListener('click', () => {
            const actual = document.documentElement.getAttribute('data-theme');
            aplicarTema(actual === 'dark' ? 'light' : 'dark');
        });

        /* ================================================================
           11. RELOJ EN VIVO
        ================================================================ */
        function actualizarReloj() {
            const ahora = new Date();
            document.getElementById('relojTiempo').textContent = ahora.toLocaleTimeString('es-CO', { hour12: false });
            document.getElementById('relojFecha').textContent = ahora.toLocaleDateString('es-CO', {
                weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
            });
        }
        setInterval(actualizarReloj, 1000);
        actualizarReloj();
        document.getElementById('fechaActualizacion').textContent = new Date().toLocaleString('es-CO');

        /* ================================================================
           12. EXPORTAR CSV
        ================================================================ */
        document.getElementById('btnExportarCSV').addEventListener('click', () => {
            const filas = filtrarProyectos();
            const header = ['Proyecto', 'Departamento', 'Municipio', 'ID Predio', 'Torres', 'Estado Concreto', 'Semáforo'];
            const csv = [header.join(';')].concat(filas.map(p =>
                [p.proyecto, p.departamento, p.municipio, p.idPredio, p.torres, p.estadoConcreto, p.semaforo].join(';')
            )).join('\n');
            const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'predios_' + new Date().toISOString().slice(0, 10) + '.csv';
            a.click();
            URL.revokeObjectURL(a.href);
            mostrarToast(filas.length + ' registros exportados a CSV', 'success');
        });

        /* ================================================================
           13. IMPRIMIR / PDF
        ================================================================ */
        document.getElementById('btnImprimir').addEventListener('click', () => {
            mostrarToast('Generando reporte…', 'info');
            setTimeout(() => window.print(), 400);
        });

        /* ================================================================
           14. INICIO
        ================================================================ */
        (function init() {
            // Tema guardado
            const temaGuardado = localStorage.getItem('geb-theme');
            if (temaGuardado) aplicarTema(temaGuardado);

            renderKpis();
            populateEstadoFilter();
            renderTabla();
            renderChips();
            renderAlertas();
            initCharts();

            console.log('✅ GEB Dashboard profesional cargado. Total:', proyectos.length);
        })();
    </script>
</body>
</html>

