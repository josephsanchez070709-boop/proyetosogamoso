            ["NORTE", "CUNDINAMARCA", "ZIPAQUIRA", "10-16-0852-V", "VANO", "LIBERADO", 3],
            ["NORTE", "CUNDINAMARCA", "ZIPAQUIRA", "10-16-0881-V", "44ANN", "LIBERADO", 3],
            ["NORTE", "CUNDINAMARCA", "ZIPAQUIRA", "10-16-0912", "VANO", "LIBERADO", 3],
            ["NORTE", "CUNDINAMARCA", "ZIPAQUIRA", "10-16-1142", "VANO", "LIBERADO", 3],
