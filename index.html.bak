<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GEB Dashboard — Proyectos NORTE y SOGAMOSO</title>
    <meta name="description" content="Dashboard profesional de control de liberación de predios GEB para los proyectos NORTE y SOGAMOSO." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        /* ========== 1. VARIABLES DE TEMA ========== */
        :root {
            --bg: #eef2f7;
            --card: #ffffff;
            --text: #0f172a;
            --text-soft: #5b6b7f;
            --muted: #94a3b8;
            --border: #e2e8f0;
            --table-head: #f8fafc;
            --row-hover: #f1f5f9;
            --shadow: 0 10px 30px rgba(15, 30, 60, 0.06), 0 2px 8px rgba(15, 30, 60, 0.04);
            --shadow-hover: 0 22px 50px rgba(15, 30, 60, 0.14);
            --header-grad: linear-gradient(120deg, #002a5c 0%, #0066b3 55%, #00875a 130%);
            --primary: #0072bc;
            --primary-soft: #e6f3fc;
            --primary-2: #00a651;
            --chip-bg: #e0f2fe;
            --chip-text: #0369a1;
            --modal-bg: rgba(15, 23, 42, 0.55);
            --chart-text: #64748b;
            --chart-grid: rgba(0, 0, 0, 0.06);
            --sem-rojo: #ef4444;
            --sem-amarillo: #f1c40f;
            --sem-verde: #22c55e;
            --blob-1: rgba(0, 114, 188, 0.12);
            --blob-2: rgba(0, 166, 81, 0.12);
            --blob-3: rgba(241, 196, 15, 0.08);
            --input-bg: #f8fafc;
            --mark-bg: #fef08a;
        }
        [data-theme="dark"] {
            --bg: #070f1e;
            --card: #101c33;
            --text: #e2e8f0;
            --text-soft: #9db0c7;
            --muted: #64748b;
            --border: #1c2b47;
            --table-head: #15233e;
            --row-hover: #162740;
            --header-grad: linear-gradient(120deg, #030e1f 0%, #063a63 55%, #075a3d 130%);
            --shadow: 0 12px 34px rgba(0, 0, 0, 0.45);
            --shadow-hover: 0 24px 54px rgba(0, 0, 0, 0.6);
            --primary: #38bdf8;
            --primary-soft: #0e2a44;
            --chip-bg: #13324a;
            --chip-text: #7dd3fc;
            --modal-bg: rgba(2, 6, 18, 0.75);
            --chart-text: #8ea3c0;
            --chart-grid: rgba(148, 163, 184, 0.12);
            --blob-1: rgba(0, 150, 255, 0.1);
            --blob-2: rgba(0, 200, 120, 0.08);
            --blob-3: rgba(241, 196, 15, 0.06);
            --input-bg: #0a1526;
            --mark-bg: #7c5314;
        }

        /* ========== 2. RESET / BASE ========== */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            padding: 22px 18px 40px;
            transition: background 0.4s ease, color 0.3s ease;
            position: relative;
        }
        .bg-blob {
            position: fixed;
            border-radius: 50%;
            filter: blur(70px);
            z-index: -1;
            pointer-events: none;
            transition: opacity 0.5s;
        }
        .bg-blob-1 { width: 480px; height: 480px; background: var(--blob-1); top: -140px; left: -120px; }
        .bg-blob-2 { width: 420px; height: 420px; background: var(--blob-2); top: 30%; right: -140px; }
        .bg-blob-3 { width: 380px; height: 380px; background: var(--blob-3); bottom: -120px; left: 30%; }
        ::-webkit-scrollbar { width: 10px; height: 10px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--muted); border-radius: 20px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--primary); }
        .container { max-width: 1560px; margin: 0 auto; }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes pulseDot {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.35); opacity: 0.6; }
        }
        @keyframes floatGlow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-6px); }
        }

        /* ========== 3. HEADER ========== */
        .header {
            background: var(--header-grad);
            color: #fff;
            padding: 26px 32px;
            border-radius: 26px;
            margin-bottom: 26px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 18px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 45px rgba(0, 40, 80, 0.35);
            animation: fadeUp 0.6s ease both;
        }
        .header::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(600px 180px at 90% 10%, rgba(255, 255, 255, 0.12), transparent 60%);
            pointer-events: none;
        }
        .header::after {
            content: "⚡";
            position: absolute;
            right: 24px;
            bottom: -22px;
            font-size: 130px;
            opacity: 0.09;
            transform: rotate(-10deg);
            filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.25));
        }
        .header-left { display: flex; align-items: center; gap: 16px; position: relative; z-index: 1; }
        .logo {
            width: 58px; height: 58px; border-radius: 18px;
            background: linear-gradient(135deg, #f1c40f, #f39c12);
            display: flex; align-items: center; justify-content: center;
            font-size: 28px; color: #002a5c;
            box-shadow: 0 10px 22px rgba(241, 196, 15, 0.45);
            animation: floatGlow 3.5s ease-in-out infinite;
        }
        .header h1 {
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            font-size: 27px;
            letter-spacing: 0.5px;
            line-height: 1.15;
            background: linear-gradient(90deg, #fff, #bde3ff);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .header h1 .energis { font-weight: 300; }
        .header .subtitle { font-size: 13.5px; opacity: 0.85; margin-top: 3px; font-weight: 400; }
        .header .subtitle i { margin-right: 5px; color: #7df0b0; }
        .header-right { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; position: relative; z-index: 1; }
        .clock-box {
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 16px;
            padding: 8px 18px;
            text-align: center;
            min-width: 158px;
        }
        .clock-box #relojTiempo { font-family: 'Outfit', monospace; font-size: 20px; font-weight: 700; letter-spacing: 1px; }
        .clock-box #relojFecha { font-size: 11.5px; opacity: 0.85; text-transform: capitalize; }
        .header-actions { display: flex; gap: 10px; flex-wrap: wrap; }
        .btn {
            border: none; cursor: pointer;
            display: inline-flex; align-items: center; gap: 8px;
            padding: 10px 18px; border-radius: 14px;
            font-family: 'Inter', sans-serif; font-weight: 600; font-size: 13.5px;
            color: #fff;
            background: rgba(255, 255, 255, 0.14);
            backdrop-filter: blur(6px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        }
        .btn:hover { transform: translateY(-2px); background: rgba(255, 255, 255, 0.24); box-shadow: 0 8px 18px rgba(0, 0, 0, 0.2); }
        .btn:active { transform: translateY(0); }
        .btn .badge-btn {
            background: #ef4444; color: #fff; border-radius: 30px;
            font-size: 11px; font-weight: 800; padding: 1px 7px; margin-left: 2px;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.25);
        }

        /* ========== 4. TARJETAS KPI ========== */
        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 18px;
            margin-bottom: 26px;
        }
        .card {
            background: var(--card);
            border-radius: 22px;
            padding: 22px 20px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            border-left: 6px solid var(--muted);
            position: relative;
            overflow: hidden;
            transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s;
            animation: fadeUp 0.6s ease both;
        }
        .card::after {
            content: "";
            position: absolute; right: -40px; top: -40px;
            width: 110px; height: 110px; border-radius: 50%;
            background: currentColor; opacity: 0.05;
        }
        .card:hover { transform: translateY(-7px); box-shadow: var(--shadow-hover); }
        .card .card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
        .card .icon {
            width: 46px; height: 46px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; background: var(--primary-soft); color: var(--primary);
        }
        .card .label {
            font-size: 12px; color: var(--text-soft);
            text-transform: uppercase; letter-spacing: 0.6px; font-weight: 700; margin-bottom: 2px;
        }
        .card .value { font-family: 'Outfit', sans-serif; font-size: 40px; font-weight: 800; line-height: 1; margin: 6px 0 6px; }
        .card .sub { font-size: 12.5px; color: var(--text-soft); display: flex; align-items: center; gap: 6px; }
        .card .sub .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; animation: pulseDot 2s infinite; }
        .card.total { border-left-color: var(--primary); }
        .card.rojo { border-left-color: var(--sem-rojo); }
        .card.amarillo { border-left-color: var(--sem-amarillo); }
        .card.verde { border-left-color: var(--sem-verde); }
        .card.liberacion { border-left-color: var(--primary-2); }
        .card.liberacion .ring-wrap { position: relative; width: 80px; height: 80px; margin: 4px auto 0; }
        .card.liberacion .ring-wrap svg { width: 100%; height: 100%; transform: rotate(-90deg); }
        .card.liberacion .ring-bg { fill: none; stroke: var(--border); stroke-width: 9; }
        .card.liberacion .ring-fg { fill: none; stroke-width: 9; stroke-linecap: round; transition: stroke-dashoffset 1.4s cubic-bezier(0.65, 0, 0.35, 1); }
        .card.liberacion .ring-lbl {
            position: absolute; inset: 0;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            font-family: 'Outfit', sans-serif;
        }
        .card.liberacion .ring-lbl b { font-size: 22px; font-weight: 800; line-height: 1; }
        .card.liberacion .ring-lbl small { font-size: 9px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
        .card.liberacion .sub { justify-content: center; margin-top: 8px; }

        .card.comp {
            grid-column: span 2;
            background: var(--header-grad); color: #fff;
            border-left: 6px solid rgba(255, 255, 255, 0.4);
        }
        .card.comp .label { color: rgba(255, 255, 255, 0.8); }
        .card.comp .mini-bars { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }
        .card.comp .mini-bar-row { display: grid; grid-template-columns: 98px 1fr 44px; align-items: center; gap: 10px; font-size: 12.5px; font-weight: 600; }
        .card.comp .bar-track { height: 12px; background: rgba(255, 255, 255, 0.18); border-radius: 30px; overflow: hidden; }
        .card.comp .bar-fill { height: 100%; border-radius: 30px; width: 0; transition: width 1.2s cubic-bezier(0.65, 0, 0.35, 1); }
        .card.comp .bar-fill.norte { background: linear-gradient(90deg, #38bdf8, #bde3ff); }
        .card.comp .bar-fill.soga { background: linear-gradient(90deg, #7df0b0, #c9f7dd); }
        .card.comp .mini-val { text-align: right; font-family: 'Outfit', sans-serif; font-size: 14px; }
        .card.comp .comp-stats { display: flex; gap: 14px; margin-top: 12px; font-size: 12px; opacity: 0.85; flex-wrap: wrap; }
        .card.comp .comp-stats span { display: inline-flex; align-items: center; gap: 5px; }
        .cards .card:nth-child(1) { animation-delay: .05s; }
        .cards .card:nth-child(2) { animation-delay: .12s; }
        .cards .card:nth-child(3) { animation-delay: .19s; }
        .cards .card:nth-child(4) { animation-delay: .26s; }
        .cards .card:nth-child(5) { animation-delay: .33s; }
        .cards .card:nth-child(6) { animation-delay: .40s; }

        /* ========== 5. GRÁFICAS ========== */
        .charts-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 22px;
        }
        .chart-box {
            background: var(--card);
            border-radius: 22px;
            padding: 18px 18px 12px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            transition: transform 0.25s ease, box-shadow 0.3s;
            animation: fadeUp 0.6s ease both;
        }
        .chart-box:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
        .chart-box h3 {
            font-family: 'Outfit', sans-serif;
            font-weight: 600; color: var(--text);
            margin-bottom: 8px; font-size: 15px;
            display: flex; align-items: center; gap: 10px;
        }
        .chart-box h3 i { color: var(--primary); font-size: 16px; }
        .chart-box .chart-body { position: relative; height: 210px; }
        .chart-box .chart-body canvas { width: 100% !important; height: 100% !important; }
        .chart-box .click-hint { font-size: 11.5px; color: var(--muted); text-align: center; margin-top: 4px; }
        .charts-grid .chart-box:nth-child(1) { animation-delay: .08s; }
        .charts-grid .chart-box:nth-child(2) { animation-delay: .14s; }
        .charts-grid .chart-box:nth-child(3) { animation-delay: .20s; }
        .charts-grid .chart-box:nth-child(4) { animation-delay: .26s; }
        .charts-grid .chart-box:nth-child(5) { animation-delay: .32s; }
        .charts-grid .chart-box:nth-child(6) { animation-delay: .38s; }
        .charts-grid .chart-box:nth-child(7) { animation-delay: .44s; }
        .charts-grid .chart-box:nth-child(8) { animation-delay: .50s; }

        /* ========== 6. FILTROS ========== */
        .filters {
            background: var(--card);
            border-radius: 22px;
            padding: 18px 22px;
            margin-bottom: 20px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            animation: fadeUp 0.6s ease both;
            animation-delay: .3s;
        }
        .filters-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px 18px; }
        .filters label {
            font-weight: 700; color: var(--text-soft);
            font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.5px;
            display: block; margin-bottom: 6px;
        }
        .filters label i { color: var(--primary); margin-right: 5px; }
        .filters select,
        .filters input {
            padding: 9px 13px;
            border-radius: 13px;
            border: 1.5px solid var(--border);
            font-family: 'Inter', sans-serif; font-size: 13.5px;
            background: var(--input-bg);
            color: var(--text);
            min-width: 150px;
            transition: border 0.2s, box-shadow 0.2s;
        }
        .filters select:focus, .filters input:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 4px rgba(0, 114, 188, 0.15);
        }
        .filters .search-wrap { position: relative; }
        .filters .search-wrap i {
            position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
            color: var(--muted); font-size: 13px;
        }
        .filters .search-wrap input { padding-left: 34px; min-width: 210px; }
        .btn-limpiar {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: #fff; border: none; cursor: pointer;
            padding: 10px 20px; border-radius: 13px;
            font-weight: 700; font-size: 13px;
            display: inline-flex; align-items: center; gap: 8px;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-limpiar:hover { transform: translateY(-2px); box-shadow: 0 10px 22px rgba(239, 68, 68, 0.4); }
        .badge-count {
            margin-left: auto;
            background: var(--primary-soft);
            color: var(--primary);
            padding: 9px 18px; border-radius: 40px;
            font-size: 13px; font-weight: 700; white-space: nowrap;
            display: flex; align-items: center; gap: 8px;
        }
        .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
        .chip {
            display: inline-flex; align-items: center; gap: 8px;
            background: var(--chip-bg); color: var(--chip-text);
            font-size: 12px; font-weight: 700;
            padding: 6px 8px 6px 13px; border-radius: 40px;
            animation: fadeUp 0.3s ease;
        }
        .chip button {
            border: none; background: rgba(0, 0, 0, 0.12);
            color: inherit; width: 18px; height: 18px; border-radius: 50%;
            font-size: 10px; cursor: pointer; display: flex; align-items: center; justify-content: center;
            transition: background 0.2s;
        }
        .chip button:hover { background: rgba(0, 0, 0, 0.25); }

        /* ========== 7. TABLA ========== */
        .table-wrapper {
            background: var(--card);
            border-radius: 22px;
            overflow: hidden;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            animation: fadeUp 0.6s ease both;
            animation-delay: .36s;
        }
        .table-scroll { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
        th {
            background: var(--table-head);
            color: var(--text-soft);
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            padding: 14px 14px;
            text-align: left;
            border-bottom: 2px solid var(--border);
            white-space: nowrap;
            position: sticky; top: 0; z-index: 2;
            cursor: pointer;
            user-select: none;
            transition: color 0.2s;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }
        th:hover { color: var(--primary); }
        th .sort-icon { font-size: 10px; margin-left: 5px; opacity: 0.5; }
        th.active .sort-icon { opacity: 1; color: var(--primary); }
        td { padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
        tbody tr { cursor: pointer; transition: background 0.15s; }
        tbody tr:hover td { background: var(--row-hover); }
        tbody tr:nth-child(even) td { background: rgba(0, 0, 0, 0.012); }
        tbody tr:nth-child(even):hover td { background: var(--row-hover); }
        mark { background: var(--mark-bg); color: inherit; border-radius: 3px; padding: 0 2px; font-weight: 800; }

        .estado-badge {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 3px 12px; border-radius: 40px;
            font-size: 11.5px; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.3px;
        }
        .estado-badge.rojo { background: rgba(239, 68, 68, 0.14); color: #dc2626; }
        .estado-badge.amarillo { background: rgba(241, 196, 15, 0.18); color: #a16207; }
        .estado-badge.verde { background: rgba(34, 197, 94, 0.15); color: #15803d; }
        .estado-badge.gris { background: rgba(100, 116, 139, 0.15); color: #475569; }
        .semafo {
            display: inline-block; width: 11px; height: 11px; border-radius: 50%; margin-right: 2px;
            vertical-align: middle;
        }
        .semafo.rojo { background: #ef4444; box-shadow: 0 0 8px rgba(239, 68, 68, 0.6); }
        .semafo.amarillo { background: #f1c40f; box-shadow: 0 0 8px rgba(241, 196, 15, 0.6); }
        .semafo.verde { background: #22c55e; box-shadow: 0 0 8px rgba(34, 197, 94, 0.6); }
        .proye-tag { font-weight: 800; }
        .proye-tag.norte { color: #0072bc; }
        .proye-tag.soga { color: #00a651; }

        .empty-row td { text-align: center; padding: 46px 0; color: var(--muted); font-style: italic; font-size: 14px; }
        .empty-row i { font-size: 34px; display: block; margin-bottom: 10px; opacity: 0.4; }

        .table-footer {
            display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
            padding: 14px 20px;
            border-top: 1px solid var(--border);
            font-size: 13px; color: var(--text-soft);
        }
        .pagination { display: flex; align-items: center; gap: 8px; }
        .page-btn {
            border: 1.5px solid var(--border); background: var(--card); color: var(--text);
            width: 34px; height: 34px; border-radius: 11px; cursor: pointer;
            display: flex; align-items: center; justify-content: center; font-size: 13px;
            transition: all 0.2s;
        }
        .page-btn:hover:not(:disabled) { border-color: var(--primary); color: var(--primary); transform: translateY(-2px); }
        .page-btn:disabled { opacity: 0.35; cursor: not-allowed; }
        .page-info { font-weight: 700; min-width: 90px; text-align: center; font-family: 'Outfit', sans-serif; }

        /* ========== 8. MODAL / ALERTAS / TOAST ========== */
        .modal-overlay {
            position: fixed; inset: 0; background: var(--modal-bg);
            backdrop-filter: blur(6px);
            display: flex; align-items: center; justify-content: center;
            z-index: 100; opacity: 0; visibility: hidden;
            transition: opacity 0.3s, visibility 0.3s;
        }
        .modal-overlay.open { opacity: 1; visibility: visible; }
        .modal {
            background: var(--card);
            width: min(560px, 92vw);
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 40px 90px rgba(0, 0, 0, 0.4);
            transform: translateY(30px) scale(0.96);
            transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
            border: 1px solid var(--border);
            max-height: 88vh; overflow-y: auto;
            position: relative;
        }
        .modal-overlay.open .modal { transform: translateY(0) scale(1); }
        .modal h2 { font-family: 'Outfit', sans-serif; font-size: 22px; margin-bottom: 4px; display: flex; align-items: center; gap: 10px; }
        .modal .modal-sub { color: var(--text-soft); font-size: 13px; margin-bottom: 20px; }
        .modal-close {
            position: absolute; top: 18px; right: 18px;
            border: none; background: var(--primary-soft); color: var(--primary);
            width: 36px; height: 36px; border-radius: 12px; cursor: pointer; font-size: 15px;
            transition: transform 0.2s;
        }
        .modal-close:hover { transform: rotate(90deg); }
        .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .detail-item {
            background: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 14px; padding: 12px 14px;
        }
        .detail-item .d-label { font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.6px; color: var(--muted); font-weight: 700; margin-bottom: 4px; }
        .detail-item .d-value { font-size: 14.5px; font-weight: 700; word-break: break-word; }

        .alerts-toggle {
            position: fixed; right: 22px; bottom: 22px; z-index: 90;
            width: 54px; height: 54px; border-radius: 18px; border: none;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: #fff; font-size: 20px; cursor: pointer;
            box-shadow: 0 14px 30px rgba(239, 68, 68, 0.45);
            transition: transform 0.25s;
            display: flex; align-items: center; justify-content: center;
        }
        .alerts-toggle:hover { transform: translateY(-4px) rotate(-6deg); }
        .alerts-toggle .badge-btn {
            position: absolute; top: -6px; right: -6px;
            background: #0f172a; color: #fff; font-size: 11px; font-weight: 800;
            min-width: 22px; height: 22px; border-radius: 30px;
            display: flex; align-items: center; justify-content: center; padding: 0 5px;
            box-shadow: 0 0 0 3px var(--bg);
        }
        .alerts-panel {
            position: fixed; right: 22px; bottom: 88px; z-index: 90;
            width: min(380px, 92vw);
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 22px;
            box-shadow: var(--shadow-hover);
            padding: 18px;
            opacity: 0; visibility: hidden; transform: translateY(16px) scale(0.97);
            transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
            max-height: 62vh; overflow-y: auto;
        }
        .alerts-panel.open { opacity: 1; visibility: visible; transform: translateY(0) scale(1); }
        .alerts-panel h3 { font-family: 'Outfit', sans-serif; font-size: 16px; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
        .alerts-panel .alerts-sub { font-size: 12px; color: var(--text-soft); margin-bottom: 14px; }
        .alert-item {
            display: flex; gap: 12px; align-items: flex-start;
            padding: 12px;
            border-radius: 14px;
            border: 1px solid var(--border);
            margin-bottom: 8px;
            background: var(--input-bg);
            transition: transform 0.2s;
        }
        .alert-item:hover { transform: translateX(4px); }
        .alert-item .a-ico { width: 36px; height: 36px; border-radius: 11px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 14px; }
        .alert-item.rojo .a-ico { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
        .alert-item.amarillo .a-ico { background: rgba(241, 196, 15, 0.18); color: #ca8a04; }
        .alert-item .a-text b { font-size: 13px; display: block; }
        .alert-item .a-text span { font-size: 11.5px; color: var(--text-soft); }

        .toast {
            position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(80px);
            background: #0f172a; color: #fff; padding: 12px 22px; border-radius: 40px;
            font-size: 13.5px; font-weight: 700; z-index: 200;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
            opacity: 0; transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
            display: flex; align-items: center; gap: 10px;
        }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
        .toast.success i { color: #22c55e; }
        .toast.info i { color: #38bdf8; }

        /* ========== 9. FOOTER ========== */
        .footer {
            text-align: center; margin-top: 26px;
            color: var(--text-soft); font-size: 12.5px;
            border-top: 1px solid var(--border); padding-top: 18px;
            display: flex; justify-content: center; align-items: center; gap: 16px; flex-wrap: wrap;
        }
        .footer .sep { opacity: 0.4; }

        /* ========== 10. IMPRESIÓN ========== */
        @media print {
            body { background: #fff !important; padding: 0; }
            .header, .btn, .charts-grid, .filters, .alerts-toggle, .alerts-panel, .bg-blob, .card.comp, .toast, .modal-overlay { display: none !important; }
            .table-wrapper { box-shadow: none; border-radius: 0; }
            th { background: #e5e7eb !important; }
        }

        /* ========== 11. RESPONSIVE ========== */
        @media (max-width: 1280px) {
            .charts-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 900px) {
            .header { flex-direction: column; align-items: flex-start; }
            .header-right { align-items: flex-start; }
            .filters-row { flex-direction: column; align-items: stretch; }
            .badge-count { margin-left: 0; justify-content: center; }
            .cards { grid-template-columns: repeat(2, 1fr); }
            .card.comp { grid-column: span 2; }
            .detail-grid { grid-template-columns: 1fr; }
        }
        @media (max-width: 520px) {
            body { padding: 14px 10px 30px; }
            .cards { grid-template-columns: 1fr; }
            .card.comp { grid-column: span 1; }
            .charts-grid { grid-template-columns: 1fr; }
            .header h1 { font-size: 20px; }
            .clock-box { min-width: 130px; }
        }
    </style>
</head>
<body data-theme="light">
    <div class="bg-blob bg-blob-1"></div>
    <div class="bg-blob bg-blob-2"></div>
    <div class="bg-blob bg-blob-3"></div>

    <div class="container">

        <!-- ========== HEADER ========== -->
        <header class="header">
            <div class="header-left">
                <div class="logo"><i class="fas fa-bolt"></i></div>
                <div>
                    <h1>GEB <span class="energis">Dashboard</span></h1>
                    <div class="subtitle">
                        <i class="fas fa-map-marked-alt"></i> Control de liberación de predios — NORTE · SOGAMOSO
                    </div>
                </div>
            </div>
            <div class="header-right">
                <div class="clock-box">
                    <div id="relojTiempo">--:--:--</div>
                    <div id="relojFecha">Cargando…</div>
                </div>
                <div class="header-actions">
                    <button class="btn" id="btnExportarCSV" title="Exportar a CSV"><i class="fas fa-file-csv"></i> CSV</button>
                    <button class="btn" id="btnImprimir" title="Generar reporte PDF / Imprimir"><i class="fas fa-print"></i> Reporte</button>
                    <button class="btn" id="btnAlerts" title="Ver alertas críticas"><i class="fas fa-bell"></i> Alertas <span class="badge-btn" id="alertCount">0</span></button>
                    <button class="btn tema" id="btnTema" title="Alternar tema"><i class="fas fa-moon" id="temaIcon"></i></button>
                </div>
            </div>
        </header>

        <!-- ========== TARJETAS KPI ========== -->
        <section class="cards" id="cardsResumen">
            <div class="card total">
                <div class="card-top">
                    <div class="label">Total predios</div>
                    <div class="icon"><i class="fas fa-layer-group"></i></div>
                </div>
                <div class="value" id="totalCard">0</div>
                <div class="sub"><span class="dot" style="background:var(--primary)"></span> registros en base</div>
            </div>
            <div class="card rojo">
                <div class="card-top">
                    <div class="label">🔴 Crítico</div>
                    <div class="icon"><i class="fas fa-exclamation-triangle"></i></div>
                </div>
                <div class="value" id="rojoCard">0</div>
                <div class="sub"><span class="dot" style="background:#ef4444"></span> no liberado / amparo</div>
            </div>
            <div class="card amarillo">
                <div class="card-top">
                    <div class="label">🟡 Alerta</div>
                    <div class="icon"><i class="fas fa-clock"></i></div>
                </div>
                <div class="value" id="amarilloCard">0</div>
                <div class="sub"><span class="dot" style="background:#f1c40f"></span> en trámite</div>
            </div>
            <div class="card verde">
                <div class="card-top">
                    <div class="label">🟢 Liberado</div>
                    <div class="icon"><i class="fas fa-check-double"></i></div>
                </div>
                <div class="value" id="verdeCard">0</div>
                <div class="sub"><span class="dot" style="background:#22c55e"></span> listo / gestionado</div>
            </div>
            <div class="card liberacion">
                <div class="card-top">
                    <div class="label">% Liberación</div>
                </div>
                <div class="ring-wrap" id="ringLiberacion"></div>
                <div class="sub"><i class="fas fa-arrow-trend-up"></i> avance global</div>
            </div>
            <div class="card comp">
                <div class="card-top">
                    <div class="label"><i class="fas fa-project-diagram"></i> NORTE vs SOGAMOSO</div>
                </div>
                <div class="mini-bars">
                    <div class="mini-bar-row">
                        <span><i class="fas fa-bolt" style="font-size:11px"></i> NORTE</span>
                        <div class="bar-track"><div class="bar-fill norte" id="barNorte"></div></div>
                        <span class="mini-val" id="valNorte">0</span>
                    </div>
                    <div class="mini-bar-row">
                        <span><i class="fas fa-bolt" style="font-size:11px"></i> SOGAMOSO</span>
                        <div class="bar-track"><div class="bar-fill soga" id="barSoga"></div></div>
                        <span class="mini-val" id="valSoga">0</span>
                    </div>
                </div>
                <div class="comp-stats" id="compStats"></div>
            </div>
        </section>

        <!-- ========== GRÁFICAS FILA 1 ========== -->
        <section class="charts-grid">
            <div class="chart-box">
                <h3><i class="fas fa-traffic-light"></i> Semáforo · General</h3>
                <div class="chart-body"><canvas id="chartSemaforo"></canvas></div>
                <div class="click-hint"><i class="fas fa-mouse-pointer"></i> Clic en el gráfico para filtrar</div>
            </div>
            <div class="chart-box">
                <h3><i class="fas fa-list-ul"></i> Estado Concreto</h3>
                <div class="chart-body"><canvas id="chartEstado"></canvas></div>
                <div class="click-hint"><i class="fas fa-mouse-pointer"></i> Clic en una barra para filtrar</div>
            </div>
            <div class="chart-box">
                <h3><i class="fas fa-columns"></i> NORTE vs SOGAMOSO</h3>
                <div class="chart-body"><canvas id="chartComparativa"></canvas></div>
            </div>
            <div class="chart-box">
                <h3><i class="fas fa-city"></i> Top 8 Municipios</h3>
                <div class="chart-body"><canvas id="chartMunicipios"></canvas></div>
            </div>
        </section>

        <!-- ========== GRÁFICAS FILA 2 ========== -->
        <section class="charts-grid">
            <div class="chart-box">
                <h3><i class="fas fa-tower-broadcast"></i> Torres por tipo</h3>
                <div class="chart-body"><canvas id="chartTorres"></canvas></div>
            </div>
            <div class="chart-box">
                <h3><i class="fas fa-gauge-high"></i> Indicador de Liberación</h3>
                <div class="chart-body"><canvas id="chartGauge"></canvas></div>
            </div>
            <div class="chart-box">
                <h3><i class="fas fa-chart-line"></i> Tendencia · Últimos 7 días</h3>
                <div class="chart-body"><canvas id="chartTendencia"></canvas></div>
            </div>
            <div class="chart-box">
                <h3><i class="fas fa-map-marked-alt"></i> Predios por departamento</h3>
                <div class="chart-body"><canvas id="chartDeptos"></canvas></div>
            </div>
        </section>

        <!-- ========== FILTROS ========== -->
        <section class="filters">
            <div class="filters-row">
                <div>
                    <label for="filtroProyecto"><i class="fas fa-tag"></i> Proyecto</label>
                    <select id="filtroProyecto">
                        <option value="todos">Todos</option>
                        <option value="NORTE">NORTE</option>
                        <option value="SOGAMOSO">SOGAMOSO</option>
                    </select>
                </div>
                <div>
                    <label for="filtroSemaforo"><i class="fas fa-traffic-light"></i> Semáforo</label>
                    <select id="filtroSemaforo">
                        <option value="todos">Todos</option>
                        <option value="rojo">🔴 Rojo</option>
                        <option value="amarillo">🟡 Amarillo</option>
                        <option value="verde">🟢 Verde</option>
                    </select>
                </div>
                <div>
                    <label for="filtroEstado"><i class="fas fa-list-ul"></i> Estado Concreto</label>
                    <select id="filtroEstado">
                        <option value="todos">Todos</option>
                    </select>
                </div>
                <div class="search-wrap">
                    <label for="filtroBusqueda"><i class="fas fa-search"></i> Buscar</label>
                    <input type="text" id="filtroBusqueda" placeholder="Municipio, ID, torre..." />
                </div>
                <button class="btn-limpiar" id="btnLimpiar"><i class="fas fa-undo-alt"></i> Limpiar</button>
                <div class="badge-count">
                    <i class="fas fa-list"></i> Mostrando <span id="filaMostradas">0</span> registros
                </div>
            </div>
            <div class="chips" id="chipsActivos"></div>
        </section>

        <!-- ========== TABLA ========== -->
        <div class="table-wrapper">
            <div class="table-scroll">
                <table>
                    <thead id="tablaHead">
                        <tr>
                            <th data-sort="proyecto">Proyecto <span class="sort-icon fas fa-sort"></span></th>
                            <th data-sort="departamento">Departamento <span class="sort-icon fas fa-sort"></span></th>
                            <th data-sort="municipio">Municipio <span class="sort-icon fas fa-sort"></span></th>
                            <th data-sort="idPredio">ID Predio <span class="sort-icon fas fa-sort"></span></th>
                            <th data-sort="torres">Torres <span class="sort-icon fas fa-sort"></span></th>
                            <th data-sort="estadoConcreto">Estado Concreto <span class="sort-icon fas fa-sort"></span></th>
                            <th data-sort="semaforo">Semáforo <span class="sort-icon fas fa-sort"></span></th>
                        </tr>
                    </thead>
                    <tbody id="tablaBody"></tbody>
                </table>
            </div>
            <div class="table-footer">
                <span id="filaInfo">0 registros</span>
                <div class="pagination">
                    <button class="page-btn" id="pagePrev" title="Anterior"><i class="fas fa-chevron-left"></i></button>
                    <span class="page-info" id="pageInfo">1 / 1</span>
                    <button class="page-btn" id="pageNext" title="Siguiente"><i class="fas fa-chevron-right"></i></button>
                </div>
            </div>
        </div>

        <footer class="footer">
            <span><i class="fas fa-bolt" style="color:#f1c40f;"></i> GEB Dashboard</span>
            <span class="sep">·</span>
            <span>Proyectos NORTE y SOGAMOSO</span>
            <span class="sep">·</span>
            <span>Última actualización: <span id="fechaActualizacion">—</span></span>
        </footer>
    </div>

    <!-- ========== BOTÓN + PANEL DE ALERTAS ========== -->
    <button class="alerts-toggle" id="alertsToggle" title="Alertas críticas">
        <i class="fas fa-bell"></i>
        <span class="badge-btn" id="alertsBadge">0</span>
    </button>
    <div class="alerts-panel" id="alertsPanel">
        <h3><i class="fas fa-exclamation-triangle" style="color:#ef4444;"></i> Alertas críticas</h3>
        <div class="alerts-sub">Predios con prioridad alta que requieren gestión</div>
        <div id="alertsList"></div>
    </div>

    <!-- ========== MODAL DETALLE ========== -->
    <div class="modal-overlay" id="modalDetalle">
        <div class="modal">
            <button class="modal-close" id="modalClose"><i class="fas fa-times"></i></button>
            <h2><i class="fas fa-map-marker-alt" style="color:var(--primary);"></i> Detalle del predio</h2>
            <div class="modal-sub" id="modalSub">Información completa del registro</div>
            <div class="detail-grid" id="modalBody"></div>
        </div>
    </div>

    <!-- ========== TOAST ========== -->
    <div class="toast" id="toast"><i class="fas fa-info-circle"></i> <span id="toastMsg"></span></div>

    <script>
        "use strict";
        /* ================================================================
           1. DATOS ORIGINALES (sin modificar)
        ================================================================ */
        const datosRaw = [
